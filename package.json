{
  "name": "school-management",
  "version": "0.1.0",
  "private": true,
  "description": "RBSE School Website & Management System (Public Website, Admin Portal, Teacher Portal)",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26.13.0 <27",
    "pnpm": ">=12.21.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "3.10.1",
    "turbo": "2.11.13"
  }
}
