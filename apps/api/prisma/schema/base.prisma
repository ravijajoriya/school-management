// Prisma schema is split by domain: one file per area (identity, audit, cms, …).
// Conventions:
//   - Models are PascalCase, mapped to snake_case tables/columns via @@map/@map.
//   - Primary keys are UUIDv7 generated by PostgreSQL 18 (`uuidv7()`): time-ordered, index-friendly.
//   - All timestamps are TIMESTAMPTZ.
//   - Status columns are VARCHAR + CHECK constraint (added in migration SQL), not Postgres enums,
//     so new statuses can be added without enum migrations. Allowed values live in @school/shared.
//   - CHECK constraints / partial indexes that Prisma cannot express are added by hand in the
//     migration SQL and noted with a `// SQL:` comment next to the field.

generator client {
  provider = "prisma-client"
  output   = "../../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}
