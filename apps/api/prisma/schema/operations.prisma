// Phase 7 — school operations
// (migrations 019_transport, 020_complaints_meetings, 021_inventory).

/// School bus / van. Registration number is unique (stored upper-case).
model Vehicle {
  id                  String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  registrationNumber  String    @unique @map("registration_number") @db.VarChar(30)
  vehicleType         String?   @map("vehicle_type") @db.VarChar(50)
  /// SQL: CHECK (capacity IS NULL OR capacity > 0)
  capacity            Int?      @db.SmallInt
  insuranceExpiry     DateTime? @map("insurance_expiry") @db.Date
  permitExpiry        DateTime? @map("permit_expiry") @db.Date
  /// SQL: CHECK (status IN ('ACTIVE','INACTIVE'))
  status              String    @default("ACTIVE") @db.VarChar(20)
  notes               String?
  /// Crew. SQL: an ACTIVE vehicle must have both (CHECK, NOT VALID for older rows);
  /// driver <> conductor; each person crews at most one active vehicle per role (partial unique).
  driverEmployeeId    String?   @map("driver_employee_id") @db.Uuid
  conductorEmployeeId String?   @map("conductor_employee_id") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  driver    Employee?        @relation("VehicleDriver", fields: [driverEmployeeId], references: [id], onDelete: Restrict)
  conductor Employee?        @relation("VehicleConductor", fields: [conductorEmployeeId], references: [id], onDelete: Restrict)
  routes    TransportRoute[]
  services  VehicleService[]

  @@index([driverEmployeeId])
  @@index([conductorEmployeeId])
  @@map("vehicles")
}

/// A service / repair visit for a vehicle.
model VehicleService {
  id              String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  vehicleId       String    @map("vehicle_id") @db.Uuid
  serviceDate     DateTime  @map("service_date") @db.Date
  garageName      String?   @map("garage_name") @db.VarChar(120)
  /// SQL: CHECK (odometer_km >= 0)
  odometerKm      Int       @map("odometer_km")
  /// SQL: CHECK (next_service_km IS NULL OR next_service_km > odometer_km)
  nextServiceKm   Int?      @map("next_service_km")
  /// SQL: CHECK (next_service_date IS NULL OR next_service_date > service_date)
  nextServiceDate DateTime? @map("next_service_date") @db.Date
  /// SQL: CHECK (labour_cost >= 0)
  labourCost      Decimal   @default(0) @map("labour_cost") @db.Decimal(12, 2)
  invoiceNumber   String?   @map("invoice_number") @db.VarChar(60)
  notes           String?
  createdBy       String    @map("created_by") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  vehicle Vehicle               @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  creator User                  @relation("VehicleServiceCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  parts   VehicleServicePart[]
  staff   VehicleServiceStaff[]

  @@index([vehicleId, serviceDate])
  @@map("vehicle_services")
}

/// New part fitted during a service. `cost` is the line total.
model VehicleServicePart {
  id        String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  serviceId String  @map("service_id") @db.Uuid
  partName  String  @map("part_name") @db.VarChar(120)
  /// SQL: CHECK (quantity > 0)
  quantity  Int     @default(1) @db.SmallInt
  /// SQL: CHECK (cost >= 0)
  cost      Decimal @db.Decimal(12, 2)

  service VehicleService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
  @@map("vehicle_service_parts")
}

/// Staff who took the vehicle for the service.
model VehicleServiceStaff {
  serviceId  String @map("service_id") @db.Uuid
  employeeId String @map("employee_id") @db.Uuid

  service  VehicleService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  employee Employee       @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@id([serviceId, employeeId])
  @@index([employeeId])
  @@map("vehicle_service_staff")
}

/// Bus route with an optional vehicle; the driver and conductor come from the vehicle.
model TransportRoute {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// SQL: UNIQUE (lower(name))
  name        String   @db.VarChar(100)
  description String?
  vehicleId   String?  @map("vehicle_id") @db.Uuid
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  vehicle     Vehicle?           @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  stops       RouteStop[]
  assignments StudentTransport[]

  @@index([vehicleId])
  @@map("transport_routes")
}

/// Ordered pickup/drop point on a route.
model RouteStop {
  id         String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  routeId    String    @map("route_id") @db.Uuid
  /// SQL: UNIQUE (route_id, lower(name))
  name       String    @db.VarChar(120)
  pickupTime DateTime? @map("pickup_time") @db.Time(0)
  dropTime   DateTime? @map("drop_time") @db.Time(0)
  /// SQL: CHECK (sequence_no > 0)
  sequenceNo Int       @map("sequence_no") @db.SmallInt

  route       TransportRoute     @relation(fields: [routeId], references: [id], onDelete: Restrict)
  assignments StudentTransport[]

  /// Target for the composite FK that keeps an assignment's stop on its route.
  @@unique([id, routeId])
  @@index([routeId])
  @@map("route_stops")
}

/// A student's route/stop for a date range (per enrolment). No fee billing here: transport is
/// billed through a fee plan or a one-off charge in Fees.
model StudentTransport {
  id                 String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  studentEnrolmentId String    @map("student_enrolment_id") @db.Uuid
  routeId            String    @map("route_id") @db.Uuid
  routeStopId        String?   @map("route_stop_id") @db.Uuid
  startDate          DateTime  @map("start_date") @db.Date
  /// SQL: CHECK (end_date IS NULL OR end_date >= start_date); no overlapping periods per enrolment (exclusion)
  endDate            DateTime? @map("end_date") @db.Date
  createdBy          String    @map("created_by") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  enrolment StudentEnrolment @relation(fields: [studentEnrolmentId], references: [id], onDelete: Restrict)
  route     TransportRoute   @relation(fields: [routeId], references: [id], onDelete: Restrict)
  /// Composite FK: the stop must belong to the same route.
  stop      RouteStop?       @relation(fields: [routeStopId, routeId], references: [id, routeId], onDelete: Restrict)
  creator   User             @relation("StudentTransportCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([studentEnrolmentId])
  @@index([routeId, endDate])
  @@index([routeStopId])
  @@map("student_transport")
}

/// Complaint / grievance register with a readable reference number.
model Complaint {
  id              String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// e.g. CMP-2026-00001 (from complaint_reference_seq)
  referenceNumber String    @unique @map("reference_number") @db.VarChar(30)
  /// SQL: CHECK (category IN (...))
  category        String    @db.VarChar(30)
  subject         String    @db.VarChar(180)
  description     String
  submittedByName String?   @map("submitted_by_name") @db.VarChar(160)
  contactPhone    String?   @map("contact_phone") @db.VarChar(20)
  /// SQL: CHECK (status IN ('OPEN','IN_PROGRESS','RESOLVED','CLOSED')); RESOLVED/CLOSED need resolution notes
  status          String    @default("OPEN") @db.VarChar(20)
  assignedTo      String?   @map("assigned_to") @db.Uuid
  resolutionNotes String?   @map("resolution_notes")
  resolvedAt      DateTime? @map("resolved_at") @db.Timestamptz(6)
  createdBy       String    @map("created_by") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  assignee User? @relation("ComplaintAssignee", fields: [assignedTo], references: [id], onDelete: Restrict)
  creator  User  @relation("ComplaintCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([assignedTo])
  @@map("complaints")
}

/// Parent–teacher meeting for a student (enrolment) with a teacher (staff record).
model ParentTeacherMeeting {
  id                 String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  studentEnrolmentId String   @map("student_enrolment_id") @db.Uuid
  teacherEmployeeId  String   @map("teacher_employee_id") @db.Uuid
  /// SQL: UNIQUE (teacher_employee_id, meeting_at) WHERE status = 'SCHEDULED'
  meetingAt          DateTime @map("meeting_at") @db.Timestamptz(6)
  venue              String?  @db.VarChar(160)
  purpose            String?
  /// SQL: CHECK (status IN ('SCHEDULED','COMPLETED','CANCELLED'))
  status             String   @default("SCHEDULED") @db.VarChar(20)
  notes              String?
  createdBy          String   @map("created_by") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  enrolment StudentEnrolment @relation(fields: [studentEnrolmentId], references: [id], onDelete: Restrict)
  teacher   Employee         @relation(fields: [teacherEmployeeId], references: [id], onDelete: Restrict)
  creator   User             @relation("MeetingCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([teacherEmployeeId, meetingAt])
  @@index([studentEnrolmentId])
  @@map("parent_teacher_meetings")
}

/// Asset category (Furniture, IT equipment, Lab, Sports…).
model InventoryCategory {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// SQL: UNIQUE (lower(name))
  name        String   @db.VarChar(100)
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  items InventoryItem[]

  @@map("inventory_categories")
}

/// Asset register entry. Quantity is edited directly (no stock movements in this phase).
model InventoryItem {
  id              String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  categoryId      String    @map("category_id") @db.Uuid
  /// e.g. AST-00001 (from inventory_asset_code_seq when not entered). SQL: unique, upper-case
  assetCode       String    @unique @map("asset_code") @db.VarChar(50)
  name            String    @db.VarChar(160)
  /// SQL: CHECK (quantity >= 0)
  quantity        Decimal   @default(1) @db.Decimal(12, 2)
  unit            String?   @db.VarChar(30)
  location        String?   @db.VarChar(120)
  /// SQL: CHECK (condition_status IN ('GOOD','NEEDS_REPAIR','DAMAGED','DISPOSED'))
  conditionStatus String    @default("GOOD") @map("condition_status") @db.VarChar(20)
  purchaseDate    DateTime? @map("purchase_date") @db.Date
  /// SQL: CHECK (purchase_cost IS NULL OR purchase_cost >= 0)
  purchaseCost    Decimal?  @map("purchase_cost") @db.Decimal(12, 2)
  notes           String?
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  category InventoryCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([categoryId])
  @@index([conditionStatus])
  @@map("inventory_items")
}
