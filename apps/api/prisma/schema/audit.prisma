// Phase 1 — migration 002_audit_logs

/// Security and business audit events. Append-only: UPDATE/DELETE are blocked by a DB trigger.
model AuditLog {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// Null for anonymous events (e.g. failed login for unknown identifier).
  userId     String?  @map("user_id") @db.Uuid
  action     String   @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(80)
  entityId   String?  @map("entity_id") @db.Uuid
  beforeJson Json?    @map("before_json")
  afterJson  Json?    @map("after_json")
  reason     String?
  ipAddress  String?  @map("ip_address") @db.Inet
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}
