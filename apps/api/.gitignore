# NestJS API — app-specific rules (root .gitignore covers env, dist, node_modules, logs)

# Generated Prisma Client (regenerated by `pnpm install` via the postinstall script)
/src/generated/

# Local file uploads (student/employee documents in development)
/storage/
/uploads/

# Local backups (pnpm backup) — contain personal data, never commit
/backups/

# Local .env copies used for one-off testing
/.env*.local
