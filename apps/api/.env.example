# Copy to .env and adjust. All variables are validated at startup (src/config/env.schema.ts).

# development | test | production
NODE_ENV=development
PORT=3000
# All routes are served under this prefix, e.g. /api/v1/health
API_PREFIX=api/v1
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173
# trace | debug | info | warn | error | fatal
LOG_LEVEL=debug

# PostgreSQL 18+ (uuidv7() is used for primary keys)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/school_management?schema=public"
# Number of reverse proxies in front of the API (0 locally, usually 1 behind a load balancer)
TRUST_PROXY=0

# --- Authentication ---
# Access-token signing secret, at least 32 characters: `openssl rand -base64 48`
JWT_ACCESS_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_ISSUER=school-management-api
JWT_AUDIENCE=school-management-web
# Access token lifetime (seconds) and refresh session lifetime (days)
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
# Must be true in production (HTTPS only cookie)
COOKIE_SECURE=false

# --- Seed (pnpm db:seed) ---
# First admin, created only if no admin exists. Leave PASSWORD empty to get a one-time temporary password.
SEED_ADMIN_NAME=School Administrator
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PHONE=
SEED_ADMIN_PASSWORD=
# Optional demo teacher (development/testing only)
SEED_TEACHER_NAME=
SEED_TEACHER_EMAIL=
SEED_TEACHER_PASSWORD=

# Uploaded files (local storage driver; S3 in production)
STORAGE_DIR=./storage
