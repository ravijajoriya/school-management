{
  "name": "@school/api",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "nest start",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint --type-aware src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:status": "prisma migrate status",
    "prisma:studio": "prisma studio",
    "db:seed": "tsx src/database/seed/run-seed.ts",
    "backup": "tsx src/database/backup/run-backup.ts backup",
    "backup:list": "tsx src/database/backup/run-backup.ts list",
    "backup:drill": "tsx src/database/backup/run-backup.ts drill",
    "restore": "tsx src/database/backup/run-backup.ts restore",
    "demo:seed": "tsx src/database/demo/run-demo.ts seed",
    "demo:clear": "tsx src/database/demo/run-demo.ts clear",
    "demo:status": "tsx src/database/demo/run-demo.ts status",
    "db:seed:prod": "node dist/database/seed/run-seed.js"
  },
  "dependencies": {
    "@nestjs/common": "12.6.0",
    "@nestjs/config": "12.1.1",
    "@nestjs/core": "12.6.0",
    "@nestjs/platform-express": "12.6.0",
    "@nestjs/swagger": "12.1.2",
    "@nestjs/terminus": "12.2.0",
    "@nestjs/throttler": "6.8.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@school/shared": "workspace:*",
    "cookie-parser": "1.4.7",
    "dotenv": "18.0.10",
    "exceljs": "^4.4.0",
    "helmet": "8.3.0",
    "jose": "6.2.18",
    "nestjs-pino": "5.3.2",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.15",
    "@nestjs/schematics": "12.0.16",
    "@nestjs/testing": "12.6.0",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "26.6.6",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "4.1.12",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "pino-pretty": "13.2.0",
    "prisma": "7.10.1",
    "source-map-support": "0.5.21",
    "supertest": "7.3.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "4.1.12"
  }
}
